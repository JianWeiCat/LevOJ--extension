{
  "manifest_version": 3,
  "name": "LevOJ 悬浮窗 AI 刷题助手",
  "version": "1.3.1",
  "description": "在 LevOJ 题目页自动抓题并一键生成可提交的 C++ 答案代码。考试/比赛页自动禁用。",
  "permissions": ["storage"],
  "host_permissions": ["http://172.16.37.108/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI 刷题助手设置" },
  "content_scripts": [
    {
      "matches": ["http://172.16.37.108/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
